#!/usr/bin/env python3
"""Recompute committed experiment summaries from committed rows, without torch or models.

Usage (from anywhere):
    python bin/resummarize            # check every registered summary; exit 1 on a mismatch
    python bin/resummarize hidden_choice couplet_routes   # only these experiments

Each experiment with a `summaries.py` exposes CHECKS, a list of dicts:
    {"rows": "<rows file name>" or ["<name>", ...], "summary": "<summary file name>",
     "fn": callable(rows, run_dir) -> summary dict,
     "ignore": ("elapsed_sec", ...)}   # keys that rows cannot reproduce (timing, ...)
`rows` and `summary` are file names inside experiments/<exp>/results/<run>/; every run
directory holding the summary and its rows is checked. With a list of rows files, `fn`
receives {name: rows} for those present (at least one). A summary matches when every number agrees to
1e-9 relative and every other value is equal. Committed results are never rewritten.
"""
from __future__ import annotations

import importlib.util
import json
import math
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
EXP = ROOT / "experiments"
sys.path.insert(0, str(EXP / "couplet_routes"))  # route_stats


def differences(want, got, path="", ignore=()):
    if isinstance(want, dict) and isinstance(got, dict):
        out = []
        for k in sorted(set(want) | set(got), key=str):
            if k in ignore:
                continue
            if k not in got:
                out.append(f"{path}{k}: missing in recomputed")
            elif k not in want:
                out.append(f"{path}{k}: not in committed summary")
            else:
                out += differences(want[k], got[k], f"{path}{k}.", ignore)
        return out
    if isinstance(want, list) and isinstance(got, list):
        if len(want) != len(got):
            return [f"{path.rstrip('.')}: length {len(want)} vs {len(got)}"]
        return [d for i, (a, b) in enumerate(zip(want, got)) for d in differences(a, b, f"{path}{i}.", ignore)]
    if isinstance(want, (int, float)) and isinstance(got, (int, float)) and not isinstance(want, bool):
        if want == got or (math.isnan(want) and math.isnan(got)):
            return []
        if math.isclose(want, got, rel_tol=1e-9, abs_tol=1e-12):
            return []
        return [f"{path.rstrip('.')}: committed {want!r}, recomputed {got!r}"]
    return [] if want == got else [f"{path.rstrip('.')}: committed {want!r}, recomputed {got!r}"]


def load_checks(exp_dir):
    spec = importlib.util.spec_from_file_location(f"{exp_dir.name}_summaries", exp_dir / "summaries.py")
    mod = importlib.util.module_from_spec(spec)
    sys.path.insert(0, str(exp_dir))
    spec.loader.exec_module(mod)
    return mod.CHECKS


def main(argv):
    only = set(argv)
    exps = sorted(p.parent for p in EXP.glob("*/summaries.py") if not only or p.parent.name in only)
    if only - {e.name for e in exps}:
        sys.exit(f"no summaries.py for: {', '.join(sorted(only - {e.name for e in exps}))}")
    ok = bad = 0
    for exp in exps:
        for check in load_checks(exp):
            for run in sorted(p for p in (exp / "results").iterdir() if p.is_dir()):
                summ_p = run / check["summary"]
                names = check["rows"] if isinstance(check["rows"], list) else [check["rows"]]
                present = [n for n in names if (run / n).exists()]
                if not summ_p.exists() or not present or (isinstance(check["rows"], str) and not present):
                    continue
                label = f"{exp.name}/{run.name}/{check['summary']}"
                try:
                    rows = {n: json.loads((run / n).read_text()) for n in present}
                    got = check["fn"](rows if isinstance(check["rows"], list) else rows[names[0]], run)
                    diffs = differences(json.loads(summ_p.read_text()), json.loads(json.dumps(got)),
                                        ignore=tuple(check.get("ignore", ())))
                except Exception as e:  # report and continue
                    diffs = [f"error: {type(e).__name__}: {e}"]
                if diffs:
                    bad += 1
                    print(f"FAIL {label}")
                    for d in diffs[:8]:
                        print(f"     - {d}")
                    if len(diffs) > 8:
                        print(f"     - ... {len(diffs) - 8} more")
                else:
                    ok += 1
                    print(f"ok   {label}")
    print(f"{ok} summaries reproduced from rows, {bad} differ")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
