#!/usr/bin/env bash
set -euo pipefail

target="${1:-neurips}"
mode="${2:-submission}"
profile="${target}-${mode}"

if [[ "$target" == "neurips" ]]; then
  cat >&2 <<'MSG'
The NeurIPS 2026 workshop version (v35) is submitted and frozen in
submissions/neurips-2026-workshop-v35/. The live source is the ICLR 2027
extension, so rendering the neurips target from it is disabled.
Render the ICLR version with:  bin/render-paper iclr submission
To rebuild the workshop version, check out Git tag neurips-2026-workshop-v35
in a separate worktree and render there (see AGENTS.md).
MSG
  exit 1
fi
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock="$root/.quarto-render.lock"

export HOME="$root/.home"
export PATH="$root/.tools/bin:$root/.tools/quarto/bin:$PATH"
# Repo-local TDS tree (vendored fonts such as Helvetica for the ICLR style)
export TEXMFHOME="$root/_extensions/texmf"
export TEXINPUTS="$root/_extensions/texmf//:$root//:${TEXINPUTS:-}"

mkdir -p "$root/dist/$profile"

if ! mkdir "$lock" 2>/dev/null; then
  echo "Another render is already running. Try again when it finishes." >&2
  exit 1
fi
trap 'rmdir "$lock"' EXIT

if [[ -f "$root/paper.tex" ]]; then
  latexmk -C "$root/paper.tex" >/dev/null 2>&1 || true
fi
rm -f "$root"/paper.{aux,bbl,bcf,blg,fdb_latexmk,fls,log,out,run.xml,synctex.gz,toc,tex}

quarto render "$root/paper.qmd" --profile "$profile"

pdf="$root/dist/$profile/paper.pdf"
tex="$root/dist/$profile/paper.tex"
manifest="$root/dist/$profile/build-manifest.json"

if [[ -f "$root/paper.tex" ]]; then
  mv "$root/paper.tex" "$tex"
fi
rm -f "$root"/paper.{aux,bbl,bcf,blg,fdb_latexmk,fls,log,out,run.xml,synctex.gz,toc}

commit="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
dirty="false"
if ! git -C "$root" diff --quiet -- . 2>/dev/null || ! git -C "$root" diff --cached --quiet -- . 2>/dev/null; then
  dirty="true"
fi

pdf_sha=""
tex_sha=""
if [[ -f "$pdf" ]]; then
  pdf_sha="$(shasum -a 256 "$pdf" | awk '{print $1}')"
fi
if [[ -f "$tex" ]]; then
  tex_sha="$(shasum -a 256 "$tex" | awk '{print $1}')"
fi

# Numbered copy of every render (paper_1.pdf, paper_2.pdf, ...) for distribution to readers.
numbered=""
if [[ -f "$pdf" ]]; then
  n=0
  for f in "$root/dist/$profile"/paper_*.pdf; do
    [[ -e "$f" ]] || continue
    k="${f##*/paper_}"; k="${k%.pdf}"
    if [[ "$k" =~ ^[0-9]+$ ]] && (( k > n )); then n=$k; fi
  done
  n=$((n + 1))
  numbered="dist/$profile/paper_$n.pdf"
  cp "$pdf" "$root/$numbered"
fi

cat > "$manifest" <<JSON
{
  "target": "$target",
  "mode": "$mode",
  "timestamp_utc": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "git_commit": "$commit",
  "git_dirty": $dirty,
  "quarto_version": "$(quarto --version)",
  "latexmk_version": "$(latexmk -v | head -n 1 | sed 's/"/\\"/g')",
  "pdf": "dist/$profile/paper.pdf",
  "pdf_sha256": "$pdf_sha",
  "tex": "dist/$profile/paper.tex",
  "tex_sha256": "$tex_sha",
  "numbered_pdf": "$numbered"
}
JSON

echo "Wrote $pdf"
echo "Wrote $tex"
echo "Wrote $manifest"
if [[ -n "$numbered" ]]; then
  echo "Wrote $root/$numbered (numbered copy for distribution)"
fi
