#!/usr/bin/env python3
"""Fail on known rendered-PDF defects and unresolved manuscript tokens."""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

pdf = Path(sys.argv[1] if len(sys.argv) > 1 else "dist/neurips-submission/paper.pdf")
if not pdf.is_file():
    raise SystemExit(f"missing PDF: {pdf}")
text = subprocess.run(
    ["pdftotext", "-layout", str(pdf), "-"], check=True, capture_output=True, text=True
).stdout
normalized_text = " ".join(
    re.sub(r"^\s*\d+\s+", "", line).strip() for line in text.splitlines()
)
normalized_text = re.sub(r"-\s+", "", normalized_text)
normalized_text = re.sub(r"\s+", " ", normalized_text)
canonical_text = normalized_text.replace("-", "")

errors = []
checks = {
    "persisted bare-prompt typo": r"\bis was rejected\b",
    "persisted S1 quote glitch": r"attribution-selected S1 features[’']\s*[’']",
    "unresolved cross-reference": r"(?:Figure|Table|Appendix|Section)\s+\?",
    "unresolved placeholder": r"\?\?|\b(?:TODO|FIXME|TBD)\b|X{3,}",
    "non-finite result": r"(?<![A-Za-z])(?:NaN|Inf)(?![A-Za-z])",
    "obsolete extreme-effect wording": r"\bextreme\b",
    "obsolete mediator-class terminology": r"\bbetween-(?:article|class)\b",
    "obsolete minute-effect wording": r"\bminute additional\b",
    "obsolete tiny-effect wording": r"\ba tiny change in intervention strength\b",
    "obsolete Figure 2 title": r"Almost all change is public",
    "stale appendix citation": r"Appendix\s+B\b",
    "nonstandard randomization name": r"magnitude-sensitive sign-randomization",
}
for label, pattern in checks.items():
    match = re.search(pattern, text, flags=re.IGNORECASE)
    if match:
        errors.append(f"{label}: {match.group(0)!r}")

pages = text.split("\f")
reference_page = next((index + 1 for index, page in enumerate(pages) if re.search(r"^\s*(?:\d+\s+)?References\s*$", page, re.MULTILINE)), None)
if reference_page is None:
    errors.append("References heading not found")
elif reference_page > 10:
    errors.append(f"main text exceeds nine pages: References begins on page {reference_page}")
else:
    reference_match = re.search(
        r"^\s*(?:\d+\s+)?References\s*$", pages[reference_page - 1], re.MULTILINE
    )
    if reference_match and re.search(r"[A-Za-z]", pages[reference_page - 1][: reference_match.start()]):
        errors.append("main-text prose appears above References on its opening page")

for phrase in (
    "13/14 families",
    "0.00092",
    "0.000122",
    "0.1015",
    "0.0986",
    "future-noun-attributed pre-article causal handles",
    "occupation-completion task adapted from prior latent-planning work",
    "Transmission route is orthogonal",
    "Mueller",
    "demonstrating private-route capacity",
    "TV magnitudes are shown separately and are not additive",
    "Responsible use and checklist notes",
    "Assets and licenses",
):
    if phrase not in normalized_text and phrase.replace("-", "") not in canonical_text:
        errors.append(f"required rendered phrase missing: {phrase!r}")

if errors:
    print("PDF lint FAILED")
    for error in errors:
        print(f"- {error}")
    raise SystemExit(1)
print(f"PDF lint passed: {pdf} ({len(pages)} extracted pages; References page {reference_page})")
